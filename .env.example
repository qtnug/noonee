# Database (Microsoft SQL Server)
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this

# Sepay / VietQR Payment
SEPAY_BANK_NAME=MB
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_API_TOKEN=

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or use CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Goong Maps (Address Autocomplete & Distance)
GOONG_API_KEY=

# Payment Simulation (set to 'true' only in development)
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION=false

# NooNee AI Chatbot (llm7.io)
LLM_API_KEY=
# Optional: customize model (default: gemini-3.1-flash-lite)
LLM_MODEL_NAME=gemini-3.1-flash-lite
