# ==========================================
# CẤU HÌNH HỆ THỐNG - QUÁN ĂN NOONEE
# ==========================================

# 1. Database Connection (SQL Server)
# Cách 1: Sử dụng connection string đầy đủ (MonsterASP / Cloud)
# DATABASE_URL="Server=tcp:siteXXXX.monsterasp.net,1433;Database=food_db;User Id=db_user;Password=db_password;TrustServerCertificate=True;"

# Cách 2: Sử dụng SQL Server cục bộ (Local SQLEXPRESS)
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_DATABASE=FoodOrderingDB
SQLSERVER_USER=foodapp
SQLSERVER_PASSWORD=FoodApp@2026!
SQLSERVER_PORT=1433
SQLSERVER_TRUST_CERT=true

# 2. Cổng Thanh Toán Sepay (VietQR Chuyển Khoản Tự Động)
# Token lấy từ trang https://my.sepay.vn/
SEPAY_API_TOKEN=demo_sepay_api_token
SEPAY_BANK_NAME=MB
SEPAY_BANK_ACCOUNT=0388889999
SEPAY_ACCOUNT_NAME="NGUYEN VAN AN - QUAN AN NOONEE"
SEPAY_WEBHOOK_KEY=sepay_webhook_secret_key

# 3. Chế độ Sandbox / Giả Lập Test (True: cho phép bấm 'Xác nhận thanh toán giả lập' khi test)
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION=true

# 4. JWT & Auth Secret
JWT_SECRET=super_secret_food_ordering_jwt_key_2026
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Cloudinary Configuration (Lưu trữ ảnh món ăn trên cloud)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
