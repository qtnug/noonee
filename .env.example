# ==============================================
# NooNee Food - Environment Variables Template
# Copy file nay thanh ".env.local" de chay local
# KHONG commit ".env.local" len Git!
# ==============================================

# --- 1. Microsoft SQL Server ---
# De trong neu chi muon chay tam che do In-Memory Fallback (local dev)
SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DATABASE=
# Tuy chon TLS cho SQL Server (local: false / true, cloud: true / true)
SQLSERVER_ENCRYPT=
SQLSERVER_TRUST_CERT=
# (Tuy chon) Chuoi ket noi gop thay cho cac bien SQLSERVER_* o tren
# DATABASE_URL=

# --- 2. Bao mat xac thuc (JWT) ---
# Bat buoc o production (nen dung chuoi ngau nhien >= 32 ky tu)
JWT_SECRET=

# --- 3. Cong thanh toan VietQR / SePay ---
# Thong tin ngan hang (server doc va cap qua /api/payment-config, KHONG can NEXT_PUBLIC_)
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
# Khoa bi mat xac thuc Webhook /api/sepay/webhook (giu tuyet doi o server)
SEPAY_API_TOKEN=
# Bat/tat nut gia lap thanh toan Sandbox o local dev ("true" hoac "false", production luon bi tat)
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION=

# --- 4. Cloudinary (Upload anh mon an trong Admin) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (Tuy chon) Dung CLOUDINARY_URL thay cho 3 bien tren
# CLOUDINARY_URL=

# --- 5. Goong Maps (Goi y dia chi & tinh khoang cach giao hang) ---
# De trong se dung bo dinh tuyen du phong noi bo cho Ha Noi
GOONG_API_KEY=

# --- 6. AI Chat tu van mon an (Groq OpenAI-compatible) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=